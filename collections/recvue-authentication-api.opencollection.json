{
  "opencollection": "1.0.0",
  "info": {
    "name": "RecVue Authentication API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.recvue.com/api/v2.0/api/scim/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Issue OAuth2 access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.recvue.com/api/v2.0/api/scim/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Issues an access token using the client_credentials grant. Authenticate with a Basic auth header or by passing client_id/client_secret as form parameters. Content-Type is application/x-www-form-urlencoded."
        }
      ]
    }
  ],
  "bundled": true
}