{
  "opencollection": "1.0.0",
  "info": {
    "name": "RecVue Authentication Pricing API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.recvue.com/api/v2.0/api/scim/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Pricing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get price lists",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.recvue.com/api/v2.0/pricelists"
          },
          "docs": "Paginated retrieval of price lists with filtering."
        }
      ]
    }
  ],
  "bundled": true
}